rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Public-safe listing reads only.
    match /listings/{listingId} {
      allow read: if resource.data.isVisible == true
                  && resource.data.permToAdvertise == true
                  && resource.data.municipality in ["Aurora", "Newmarket", "Richmond Hill", "Vaughan", "King", "Toronto"];
      allow write: if false; // server-only sync writes
    }

    match /savedHomes/{docId} {
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.listingId is string;

      allow read, delete: if request.auth != null
                          && resource.data.userId == request.auth.uid;

      allow update: if request.auth != null
                    && resource.data.userId == request.auth.uid
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.listingId == resource.data.listingId;
    }

    match /savedSearches/{docId} {
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.label is string
                    && request.resource.data.path is string
                    && request.resource.data.queryString is string
                    && request.resource.data.filters is map
                    && request.resource.data.alertsEnabled is bool
                    && request.resource.data.alertFrequency in ["instant", "daily", "weekly"];

      allow read, delete: if request.auth != null
                          && resource.data.userId == request.auth.uid;

      allow update: if request.auth != null
                    && resource.data.userId == request.auth.uid
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.alertsEnabled is bool
                    && request.resource.data.alertFrequency in ["instant", "daily", "weekly"];
    }

    // Private operational collections: server only
    match /listingSnapshots/{docId} {
      allow read, write: if false;
    }

    match /syncJobs/{docId} {
      allow read, write: if false;
    }

    match /settings/{docId} {
      allow read, write: if false;
    }

    match /schools/{docId} {
      allow read, write: if false; // server-rendered and imported through controlled backend endpoints only
    }

    match /leads/{docId} {
      allow read: if request.auth != null
                  && resource.data.userId == request.auth.uid;
      allow write: if false; // through controlled backend endpoints only
    }

    match /contactMessages/{docId} {
      allow read, write: if false; // through controlled backend endpoints only
    }
  }
}
